#!/bin/bash
# loom — screen recording with a circular webcam overlay. Run again to stop.
set -u

GSR='^gpu-screen-recorder'
STATE_DIR=${XDG_RUNTIME_DIR:-/tmp}
ACTIVE=$STATE_DIR/loom-recording.pid
PAUSED=$STATE_DIR/loom-paused
MIC=$STATE_DIR/loom-mic       # read by the bar panel; loom-cam writes the camera one
CAM=$STATE_DIR/loom-camera
PAUSE_KEY='SUPER + ALT + P'
BIN=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")") # ~/.local/bin is a symlink into the repo

# The pause key only means anything while recording, so it's bound for exactly that long, at
# runtime, rather than written into ~/.config/hypr/bindings.lua — which an omarchy update or a
# dotfiles sync overwrites. `hyprctl keyword` no longer parses in Quattro; `eval` runs Lua in the
# config's scope, where `o` and `hl` live. Lost if Hyprland reloads mid-recording (rebind by
# restarting the recording); a stale bind is harmless, loom-pause exits 0 with no recorder up.
if pgrep -f "$GSR" >/dev/null; then
  # No un-pause needed first: gsr 6.0.0 saves a valid file on SIGINT while paused (tested).
  rm -f "$ACTIVE" "$PAUSED" "$MIC" "$CAM"
  hyprctl eval "hl.unbind([[$PAUSE_KEY]])" >/dev/null

  # Omarchy owns finalization, but its stock toast has one click target. Suppress only that success
  # toast and replace it after finalization with Loom's preview + upload actions; error toasts pass
  # through unchanged. The filename file is removed by the recorder, so read it before stopping.
  filename=$(cat /tmp/omarchy-screenrecord-filename 2>/dev/null || true)
  saved=$STATE_DIR/loom-recording-saved
  rm -f "$saved"
  PATH="$(dirname "$BIN")/libexec:$PATH" omarchy-capture-screenrecording
  status=$?

  if [[ -f $saved && -f $filename ]]; then
    preview=$STATE_DIR/loom-preview-$(basename "${filename%.mp4}").png
    ffmpeg -y -v error -ss 0.1 -i "$filename" -frames:v 1 -q:v 2 "$preview" 2>/dev/null || preview=
    if ! omarchy-shell loom-toast show "$filename" "$preview" >/dev/null 2>&1; then
      fallback=("Screen recording saved" "Click to open" -t 10000)
      [[ -z $preview ]] || fallback+=(--image "$preview")
      fallback+=(--exec mpv -- "$filename")
      omarchy-notification-send "${fallback[@]}"
    fi
    printf '%s\n' "$filename"
  fi
  rm -f "$saved"
  exit "$status"
fi

# Also clear stale state on start: recordings can be stopped outside Loom's own stop path.
omarchy-shell -q loom-toast close
rm -f "$ACTIVE" "$PAUSED" "$MIC" "$CAM" "$STATE_DIR"/loom-preview-*.png

# Recorder FIRST: it returns once gsr is up, so nothing extra is in the slurp picker.
# gsr running is the signal, not the exit code: a cancelled picker and a failed start both come
# back non-zero, and the exit code says nothing about whether an overlay would be orphaned.
omarchy-capture-screenrecording --with-microphone-audio
pid=$(pgrep -o -f "$GSR") || exit 1 # picker cancelled -> no orphan overlay
printf '%s\n' "$pid" >"$ACTIVE"       # lets the bar distinguish Loom from other recordings

# Snapshot the mic for the panel. A snapshot, not a live read: gsr resolves `default_input` once,
# when it starts, and then keeps that source for the whole recording — changing the system default
# mid-recording leaves gsr on the old one (measured), so the value at start is the true one.
pactl -f json list sources 2>/dev/null |
  jq -r --arg n "$(pactl get-default-source 2>/dev/null)" '.[] | select(.name == $n) | .description' >"$MIC"

hyprctl eval "o.bind([[$PAUSE_KEY]], [[Pause recording]], [[$BIN/loom-pause]])" >/dev/null

exec loom-cam "$@" # "$@" = optional /dev/videoN override
