#!/bin/bash
# loom — screen recording with a circular webcam overlay. Run again to stop.
set -u

GSR='^gpu-screen-recorder'
STATE_DIR=${XDG_RUNTIME_DIR:-/tmp}
ACTIVE=$STATE_DIR/loom-recording.pid
PAUSED=$STATE_DIR/loom-paused
MIC=$STATE_DIR/loom-mic       # read by the bar panel; loom-cam writes the camera one
MIC_SOURCE=$STATE_DIR/loom-mic-source # pulse name of that mic, for the panel's live mute/level
CAM=$STATE_DIR/loom-camera
STARTED=$STATE_DIR/loom-started       # monotonic start, for the panel's timer
PAUSED_TOTAL=$STATE_DIR/loom-paused-total
PAUSE_KEY='SUPER + ALT + P'
BIN=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")") # ~/.local/bin is a symlink into the repo
# Omarchy discards gpu-screen-recorder's stderr unless its debug flag is set, and that stderr is
# the only account of why a start failed — without it a recorder that dies on launch (no encoder
# in a VM, no DRM node, unsupported codec) leaves an empty terminal and no notification. Turn it
# on for our launches; an explicit OMARCHY_SCREENRECORD_DEBUG=false still wins.
RECORDER_STATE_DIR=${XDG_RUNTIME_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/omarchy}
RECORDER_LOG=${LOOM_RECORDER_LOG:-$RECORDER_STATE_DIR/omarchy-screenrecord.log}
export OMARCHY_SCREENRECORD_DEBUG=${OMARCHY_SCREENRECORD_DEBUG:-true}

warn() { printf 'loom: %s\n' "$*" >&2; }

case ${1:-} in
doctor | --check) # prerequisites report; args pass through (e.g. --record)
  shift
  exec "$BIN/loom-doctor" "$@"
  ;;
esac

# The pause key only means anything while recording, so it's bound for exactly that long, at
# runtime, rather than written into ~/.config/hypr/bindings.lua — which an omarchy update or a
# dotfiles sync overwrites. `hyprctl keyword` no longer parses in Quattro; `eval` runs Lua in the
# config's scope, where `o` and `hl` live. Lost if Hyprland reloads mid-recording (rebind by
# restarting the recording); a stale bind is harmless, loom-pause exits 0 with no recorder up.
if pgrep -f "$GSR" >/dev/null; then
  # No un-pause needed first: gsr 6.0.0 saves a valid file on SIGINT while paused (tested).
  rm -f "$ACTIVE" "$PAUSED" "$PAUSED_TOTAL" "$STARTED" "$MIC" "$MIC_SOURCE" "$CAM"
  hyprctl eval "hl.unbind([[$PAUSE_KEY]])" >/dev/null

  # Omarchy owns finalization, but its stock toast has one click target. Suppress only that success
  # toast and replace it after finalization with Loom's preview + upload actions; error toasts pass
  # through unchanged. The filename file is removed by the recorder, so read it before stopping.
  filename=$(cat "$RECORDER_STATE_DIR/omarchy-screenrecord-filename" 2>/dev/null || true)
  saved=$STATE_DIR/loom-recording-saved
  rm -f "$saved"
  PATH="$(dirname "$BIN")/libexec:$PATH" omarchy-capture-screenrecording
  status=$?

  if [[ -f $saved && -f $filename ]]; then
    preview=$STATE_DIR/loom-preview-$(basename "${filename%.mp4}").png
    ffmpeg -y -v error -ss 0.1 -i "$filename" -frames:v 1 -q:v 2 "$preview" 2>/dev/null || preview=
    if "${LOOM_NOTIFY_BIN:-$BIN/loom-notify}" "$filename" "$preview" >/dev/null; then
      [[ -z $preview ]] || rm -f "$preview"
    else
      fallback=("Screen recording saved" "Click to open" -t 0)
      [[ -z $preview ]] || fallback+=(--image "$preview")
      fallback+=(--exec mpv -- "$filename")
      omarchy-notification-send "${fallback[@]}"
    fi
    printf '%s\n' "$filename"
  fi
  rm -f "$saved"
  exit "$status"
fi

# Also clear stale state on start: recordings can be stopped outside Loom's own stop path.
rm -f "$ACTIVE" "$PAUSED" "$PAUSED_TOTAL" "$STARTED" "$MIC" "$MIC_SOURCE" "$CAM"
find "$STATE_DIR" -maxdepth 1 -name 'loom-preview-*.png' -mtime +7 -delete 2>/dev/null || true

# Probe the default input before the picker only to decide the launch args: Omarchy either
# passes default_input to gsr (--with-microphone-audio) or records with no audio args. A
# missing/failed lookup, a source that isn't in the list, or a monitor source means screen-only
# — never substitute desktop audio. Omarchy has no pinned-source API, so this probe is not the
# captured device: the default can change during the picker, and gsr then records whatever
# default_input is at launch. After gsr is confirmed up, re-read the default and snapshot that
# launch-time source for the panel — best-effort, not an atomic capture. If that post-launch
# lookup fails, omit mic metadata rather than publish a stale pre-picker source.
read_default_mic() {
  source_name=
  muted=
  description=
  local sources_json mic_line monitor_class
  source_name=$(pactl get-default-source 2>/dev/null) || source_name=
  [[ -n $source_name ]] || return 1
  # Capture pactl's status ourselves: a pipeline into jq would keep jq's 0 even when pactl
  # printed valid JSON and then exited nonzero.
  if ! sources_json=$(pactl -f json list sources 2>/dev/null); then
    source_name=
    return 1
  fi
  # Class/mute must be nonempty so TSV never starts with a tab. Bash treats tab as IFS
  # whitespace and would otherwise collapse a missing device.class, shifting mute into class
  # and the description into mute.
  mic_line=$(jq -r --arg n "$source_name" '
    .[] | select(.name == $n) |
    [
      ((.properties["device.class"] // "") | if . == "" then "sound" else . end),
      (.mute == true | tostring),
      (.description // "")
    ] | @tsv
  ' <<<"$sources_json" 2>/dev/null) || mic_line=
  [[ -n ${mic_line:-} ]] || { source_name=; return 1; }
  IFS=$'\t' read -r monitor_class muted description <<<"$mic_line"
  if [[ ${monitor_class:-} == monitor || $source_name == *.monitor ]]; then
    source_name=
    muted=
    description=
    return 1
  fi
  return 0
}

have_mic=0
if read_default_mic; then
  have_mic=1
fi

# Recorder FIRST: it returns once gsr is up, so nothing extra is in the slurp picker.
# gsr running is the signal, not the exit code: a cancelled picker and a failed start both come
# back non-zero, and the exit code says nothing about whether an overlay would be orphaned.
#
# Everything Omarchy appends for this launch starts past this offset. Its "===== ... =====" header
# is written only after a capture target is picked, so new bytes with no header at all means the
# picker was cancelled — not a broken recorder.
log_mark=0
[[ ! -f $RECORDER_LOG ]] || log_mark=$(stat -c %s "$RECORDER_LOG" 2>/dev/null || echo 0)

recorder_log_new() { tail -c "+$((log_mark + 1))" "$RECORDER_LOG" 2>/dev/null; }
recorder_launched() { recorder_log_new | grep -q '^===== '; }
recorder_error() { recorder_log_new | grep -v -e '^===== ' -e '^[[:space:]]*$'; }

if [[ $have_mic -eq 1 ]]; then
  omarchy-capture-screenrecording --with-microphone-audio
else
  omarchy-capture-screenrecording
fi

# gsr running is the signal, and Omarchy exits 0 even when the recorder died on launch, so this is
# also the only place a failed start can be reported. Say which of the two it was: a cancelled
# picker is routine, a dead recorder needs its stderr in front of the user.
if ! pid=$(pgrep -o -f "$GSR"); then # no overlay, no published state
  if recorder_launched; then
    detail=$(recorder_error)
    warn 'gpu-screen-recorder exited immediately — no recording started.'
    if [[ -n $detail ]]; then
      printf '%s\n' "$detail" >&2
    else
      warn "the recorder logged no error; full log: $RECORDER_LOG"
    fi
    warn "run 'loom doctor' to check the recorder's prerequisites"
    # The last stderr line is usually gsr's own reason; the toast is often all a hotkey user sees.
    body=$(printf '%s' "$detail" | tail -n 1)
    omarchy-notification-send -u critical -t 8000 'Loom: recording failed to start' \
      "${body:-Run \"loom doctor\" in a terminal for details.}" || true
  else
    warn 'no recording started (screen picker cancelled)'
  fi
  exit 1
fi
printf '%s\n' "$pid" >"$ACTIVE"       # lets the bar distinguish Loom from other recordings

# Timer baseline, published after the PID so a loom-status poll landing in between can't sweep it
# away as stale state. Monotonic, so an NTP step doesn't jump the panel's clock.
read -r uptime_now _ </proc/uptime
printf '%s\n' "${uptime_now%.*}" >"$STARTED"
printf '0\n' >"$PAUSED_TOTAL"

if [[ $have_mic -eq 1 ]]; then
  # Re-read after launch: the pre-picker probe only decided the flag. If the default moved during
  # the picker, this is the source gsr's default_input most likely captured. Failed lookup here
  # leaves the panel at unknown — better than asserting the pre-picker source was recorded.
  if read_default_mic; then
    printf '%s\n' "$source_name" >"$MIC_SOURCE"
    printf '%s\n' "${description:-}" >"$MIC"
    # The one mistake that costs a whole take. The panel shows it for as long as it lasts; this fires
    # once, now, while the recording is still a few seconds long.
    if [[ ${muted:-} == true ]]; then
      omarchy-notification-send -u critical -t 8000 "Loom: microphone is muted" \
        "${description:-Default input} is muted — this recording will have no voice."
    fi
  fi
fi

hyprctl eval "o.bind([[$PAUSE_KEY]], [[Pause recording]], [[$BIN/loom-pause]])" >/dev/null

# Overlay is optional: a missing camera or a failed helper must not fail the recording, and must
# not kill gsr. Nonzero from loom-cam is an overlay error, not a recording error.
loom-cam "$@" || true # "$@" = optional /dev/videoN override
exit 0
