#!/bin/bash
# Reports state only for recorder PID started by loom.
state_dir=${XDG_RUNTIME_DIR:-/tmp}
active=$state_dir/loom-recording.pid
paused=$state_dir/loom-paused

if [[ -r $active ]]; then
  read -r pid <"$active"
  if [[ $pid =~ ^[0-9]+$ ]] && pgrep -f '^gpu-screen-recorder' | grep -qx "$pid"; then
    [[ -f $paused ]] && echo paused || echo recording
    exit 0
  fi
fi

# Deliberately does not clear loom-mic / loom-camera: this runs every 500ms from the bar, and the
# overlay can be up before the recording is (it's also runnable on its own). `loom` clears them
# when a recording starts, which is the only time they are read.
rm -f "$active" "$paused"
echo inactive
